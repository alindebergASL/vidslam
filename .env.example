# Copy to .env and edit. The defaults below are safe for a fully-mocked local run.

# --- Core ---
# When true, all external providers are mocked (no API keys needed, end-to-end demo works).
MOCK_PROVIDERS=true

# Single shared password for the MVP gate (used by frontend middleware + backend /api/auth/login).
MVP_PASSWORD=changeme

# Cookie signing key for the password gate session. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public base URL the *backend* is reachable at (used to build tokenized asset URLs sent to providers).
# In docker-compose this is the host-visible URL; in EC2 it's your domain.
PUBLIC_BASE_URL=http://localhost:8000

# Where the Next.js frontend reaches the backend (browser-side; CORS must allow it).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Rate limiting (generation endpoints only) ---
# Generation routes call paid providers, so they're throttled per client
# (session cookie, IP fallback). Cancel is never throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERATION_BURST=10
RATE_LIMIT_GENERATION_PER_MINUTE=10

# --- Database / queue / storage ---
DATABASE_URL=sqlite:////data/app.db
DATA_DIR=/data
REDIS_URL=redis://redis:6379/0

# --- Provider API keys ---
# Each provider key below can also be pasted in Settings → API keys. A key
# saved there is stored encrypted in the database (keyed by SESSION_SECRET,
# so rotating SESSION_SECRET means re-entering it) and overrides the value
# here, for the web app and the worker alike. Leave these empty to manage
# keys only from the app. MOCK_PROVIDERS=true overrides every key.

# --- OpenRouter (chat + image + video) ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=AvatarVideoStudio
# Defaults; each can be switched live in Settings → Models (stored in the DB).
# Planner: newest cheap model with structured outputs (gpt-4o-mini is from 2024).
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
# Adult content on this deployment. false = a clean deployment: adult mode stays
# off whatever ADULT_MODE or Settings say, Runware's content check and Sogni's safe
# filter are always on, uncensored models are hidden and refused, and the Adult
# content settings disappear from the app. The planner checks that scripts, captions
# and every picture or video prompt aren't sexually explicit (a 422 when it can't
# say), and so are music and sound prompts; no model of the adult text family is the
# planner under any vendor; and new voiceover and music uploads are refused (nothing
# here can transcribe them; an uploaded video keeps no sound). Music uploaded before
# the switch is still played. See README. Start a clean deployment from an empty
# database and data directory, not a copy of one that allowed adult content: the
# pictures, videos, prompts and model names already there would still be shown
# (the app logs a warning at startup when it finds saved Adult content settings).
ADULT_FEATURES=true
# Adult mode (Settings → Adult content overrides this default). On: planning,
# ✨ Enhance and scene rewrites use ADULT_TEXT_MODEL, and the picture/video filters
# follow their switches in Settings → API keys (defaults: RUNWARE_CHECK_CONTENT,
# SOGNI_SAFE_CONTENT_FILTER). Off: the planner above, and Runware's check and
# Sogni's filter on. Prompts sexualising minors are refused either way.
ADULT_MODE=false
ADULT_TEXT_MODEL=deepseek/deepseek-v4-flash
# Enhance retries a decline with this one (adult mode only).
ADULT_TEXT_FALLBACK_MODEL=deepseek/deepseek-v4-pro
# Cast pictures: before a character is ticked "Adult content allowed", and when a
# picture is added to a ticked card, a small copy of each picture on the card goes
# to this model (through OpenRouter; it must take images) to check that nobody in
# it looks under 18. The card's text goes to the planner.
CHARACTER_PICTURE_CHECK_MODEL=deepseek/deepseek-v4.1-flash
# Image: reference-capable model for avatar consistency + ambient stills.
OPENROUTER_IMAGE_MODEL=google/gemini-nano-banana-2.1
# Video: up to 30 s per call with first+last frame (closed ambient loops).
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
# Ambient scene stills (anchor frame, generated picture, Still + drift,
# preset previews), made at each model's best settings (quality "max",
# resolution 2K). Retried with the fallback model if the call fails.
# Empty AMBIENT_STILL_MODEL = OPENROUTER_IMAGE_MODEL / Settings → Models.
# A scene's own "Picture model" choice wins over both.
AMBIENT_STILL_MODEL=openai/gpt-image-2.6-sunburst
AMBIENT_STILL_FALLBACK_MODEL=google/gemini-nano-banana-2.1
# Video jobs are event-driven: submit returns at once and OpenRouter calls
# {PUBLIC_BASE_URL}/api/webhooks/openrouter/videos/<token> when a clip is done.
# auto = on when PUBLIC_BASE_URL is https and providers are live · on · off (poll only)
VIDEO_WEBHOOKS=auto
# Workspace webhook signing secret (OpenRouter → Settings → Webhooks). When set,
# unsigned or stale (>5 min) deliveries are rejected with 401.
OPENROUTER_WEBHOOK_SECRET=
# Poll cadence without webhooks / safety-net poll with them, and the job deadline.
VIDEO_POLL_SECONDS=10
VIDEO_SAFETY_POLL_SECONDS=120
VIDEO_JOB_TIMEOUT_MINUTES=45

# --- ElevenLabs (TTS, optional) ---
# Google Gemini API key — enables Lyria music models (google/lyria-3.5 …).
GEMINI_API_KEY=
# How often the model catalog is re-polled from OpenRouter / Gemini (hours; 0 = off).
MODEL_CATALOG_REFRESH_HOURS=6

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# eleven_turbo_v2_5 is deprecated. Quality: eleven_multilingual_v2 · fast: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Eleven Music model (music_v1, the API default, is deprecated — removed 2027-01-31)
ELEVENLABS_MUSIC_MODEL_ID=music_v2_5

# Runware (runware.ai): image + video models, ids "runware/<AIR>". Optional;
# a key saved in Settings → API keys wins. RUNWARE_CHECK_CONTENT is the default
# for the content-check box on Runware's row there; it only applies in Adult
# mode (off: always checked). Off = uncensored on Runware-hosted open models.
# Minors are always refused. Still checked in Adult mode: pictures of Cast
# characters not ticked "Adult content allowed", and prompts that mention a child.
RUNWARE_API_KEY=
RUNWARE_CHECK_CONTENT=false
# 1080p or 720p (about half the price per second)
RUNWARE_VIDEO_RESOLUTION=1080p

# --- Sogni (image + video, optional) ---
# Enables the sogni/<model> image and video models. Get a key at
# https://dashboard.sogni.ai/api-keys (paid in Spark; or set it in Settings → API keys).
SOGNI_API_KEY=
SOGNI_BASE_URL=https://api.sogni.ai
# Default for the safe-filter box on Sogni's row in Settings → API keys (that box
# wins once set). It only applies in Adult mode: off, the filter is always on.
# Still on in Adult mode: pictures of Cast characters not ticked "Adult content
# allowed", and prompts that mention a child.
SOGNI_SAFE_CONTENT_FILTER=false
# Native Sogni models run on Free Spark and count $0 toward Spend; only vendor
# (Premium Spark) models count. true = count Free Spark models at list price.
SOGNI_COUNT_FREE_SPARK=false
# Sogni's published tool schemas: the list of image/video models its API
# accepts (there's no listing endpoint). Synced with the model catalog; empty
# = only the copy bundled with the app (backend/app/providers/sogni_tools.json).
SOGNI_TOOLS_MANIFEST_URL=https://cdn.jsdelivr.net/npm/@sogni-ai/sogni-protocol@alpha/manifests/generation-tools.json
# Reference pictures on Sogni picture models are made with Sogni's edit_image
# tool. Editors when the picked model has none of its own (scene / character):
SOGNI_EDIT_REFERENCES=true
SOGNI_SCENE_EDIT_MODEL=flux-3-klein
SOGNI_IDENTITY_EDIT_MODEL=krea-identity-edit
# Day to night on a Sogni Picture model: true tries the Sogni edit ($0 on Free
# Spark with Sogni's own editors) before the fallback picture model (Nano
# Banana, more realistic, ~$0.055 a still).
SOGNI_SAME_PLACE_FIRST=false

# --- Replicate (LoRA training, optional) ---
REPLICATE_API_TOKEN=

# --- Spend tracking ---
# Every paid call is recorded (Settings → Spend). OpenRouter reports real
# costs; ElevenLabs / Gemini use the COST_* rate card below. These are the
# defaults for the monthly budget, which Settings → Spend overrides.
# 0 = no cap. HARD_STOP=true refuses new paid generations (HTTP 402) at 100%.
SPEND_MONTHLY_BUDGET_USD=0
SPEND_HARD_STOP=true
# Rate card (USD) for providers that don't report cost, and for estimates.
COST_CHAT_PER_PLAN=0.01
COST_IMAGE_PER_ITEM=0.04
# One ambient still on AMBIENT_STILL_MODEL at its best settings.
COST_AMBIENT_STILL=0.13
COST_VIDEO_PER_SECOND=0.15
COST_AVATAR_PER_SECOND=0.05
COST_TTS_PER_1K_CHARS=0.20
COST_MUSIC_PER_GENERATION=0.05
COST_SOUND_PER_GENERATION=0.10

# --- Job queue ---
# auto = RQ when Redis answers, inline otherwise (dev). required = 503 instead
# of running jobs inline (production). inline = never use Redis.
QUEUE_MODE=auto
QUEUE_JOB_TIMEOUT_SECONDS=14400

# --- Renders ---
# Keep the newest N completed renders per project (0 = keep all).
RENDER_RETENTION_KEEP=0

# --- Alerts (Slack / Discord incoming webhook; empty = log only) ---
ALERT_WEBHOOK_URL=

# --- Backups (scripts/backup.sh; see docs/backups.md) ---
# Directory to back up into: usually an Amazon S3 Files mount. Or s3://bucket/prefix (needs the aws CLI).
BACKUP_TARGET=
BACKUP_KEEP_DAYS=14
ALERT_DEDUPE_MINUTES=30
ALERT_PROVIDER_ERRORS=5

# --- YouTube publishing (Google OAuth client, type "Web application") ---
# Authorized redirect URI: {PUBLIC_BASE_URL}/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
