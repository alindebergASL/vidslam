# Copy to .env and edit. The defaults below are safe for a fully-mocked local run.

# --- Core ---
# When true, all external providers are mocked (no API keys needed, end-to-end demo works).
MOCK_PROVIDERS=true

# Single shared password for the MVP gate (used by frontend middleware + backend /api/auth/login).
MVP_PASSWORD=changeme

# Cookie signing key for the password gate session. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public base URL the *backend* is reachable at (used to build tokenized asset URLs sent to providers).
# In docker-compose this is the host-visible URL; in EC2 it's your domain.
PUBLIC_BASE_URL=http://localhost:8000

# Where the Next.js frontend reaches the backend (browser-side; CORS must allow it).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Rate limiting (generation endpoints only) ---
# Generation routes call paid providers, so they're throttled per client
# (session cookie, IP fallback). Cancel is never throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERATION_BURST=10
RATE_LIMIT_GENERATION_PER_MINUTE=10

# --- Database / queue / storage ---
DATABASE_URL=sqlite:////data/app.db
DATA_DIR=/data
REDIS_URL=redis://redis:6379/0

# --- OpenRouter (chat + image + video) ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=AvatarVideoStudio
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VIDEO_MODEL=

# --- ElevenLabs (TTS, optional) ---
# Google Gemini API key — enables Lyria music models (google/lyria-3.5 …).
GEMINI_API_KEY=
# How often the model catalog is re-polled from OpenRouter / Gemini (hours; 0 = off).
MODEL_CATALOG_REFRESH_HOURS=6

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Eleven Music model (music_v1, the API default, is deprecated — removed 2027-01-31)
ELEVENLABS_MUSIC_MODEL_ID=music_v2_5

# --- Job queue ---
# auto = RQ when Redis answers, inline otherwise (dev). required = 503 instead
# of running jobs inline (production). inline = never use Redis.
QUEUE_MODE=auto
QUEUE_JOB_TIMEOUT_SECONDS=14400

# --- Renders ---
# Keep the newest N completed renders per project (0 = keep all).
RENDER_RETENTION_KEEP=0

# --- Alerts (Slack / Discord incoming webhook; empty = log only) ---
ALERT_WEBHOOK_URL=
ALERT_DEDUPE_MINUTES=30
ALERT_PROVIDER_ERRORS=5

# --- YouTube publishing (Google OAuth client, type "Web application") ---
# Authorized redirect URI: {PUBLIC_BASE_URL}/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
