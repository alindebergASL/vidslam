# Copy to .env and edit. The defaults below are safe for a fully-mocked local run.

# --- Core ---
# When true, all external providers are mocked (no API keys needed, end-to-end demo works).
MOCK_PROVIDERS=true

# Single shared password for the MVP gate (used by frontend middleware + backend /api/auth/login).
MVP_PASSWORD=changeme

# Cookie signing key for the password gate session. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Public base URL the *backend* is reachable at (used to build tokenized asset URLs sent to providers).
# In docker-compose this is the host-visible URL; in EC2 it's your domain.
PUBLIC_BASE_URL=http://localhost:8000

# Where the Next.js frontend reaches the backend (browser-side; CORS must allow it).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Rate limiting (generation endpoints only) ---
# Generation routes call paid providers, so they're throttled per client
# (session cookie, IP fallback). Cancel is never throttled.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERATION_BURST=10
RATE_LIMIT_GENERATION_PER_MINUTE=10

# --- Database / queue / storage ---
DATABASE_URL=sqlite:////data/app.db
DATA_DIR=/data
REDIS_URL=redis://redis:6379/0

# --- OpenRouter (chat + image + video) ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_TITLE=AvatarVideoStudio
# Defaults; each can be switched live in Settings → Models (stored in the DB).
# Planner: newest cheap model with structured outputs (gpt-4o-mini is from 2024).
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
# Image: reference-capable model for avatar consistency + ambient stills.
OPENROUTER_IMAGE_MODEL=google/gemini-nano-banana-2.1
# Video: up to 30 s per call with first+last frame (closed ambient loops).
OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0
# Video jobs are event-driven: submit returns at once and OpenRouter calls
# {PUBLIC_BASE_URL}/api/webhooks/openrouter/videos/<token> when a clip is done.
# auto = on when PUBLIC_BASE_URL is https and providers are live · on · off (poll only)
VIDEO_WEBHOOKS=auto
# Workspace webhook signing secret (OpenRouter → Settings → Webhooks). When set,
# unsigned or stale (>5 min) deliveries are rejected with 401.
OPENROUTER_WEBHOOK_SECRET=
# Poll cadence without webhooks / safety-net poll with them, and the job deadline.
VIDEO_POLL_SECONDS=10
VIDEO_SAFETY_POLL_SECONDS=120
VIDEO_JOB_TIMEOUT_MINUTES=45

# --- ElevenLabs (TTS, optional) ---
# Google Gemini API key — enables Lyria music models (google/lyria-3.5 …).
GEMINI_API_KEY=
# How often the model catalog is re-polled from OpenRouter / Gemini (hours; 0 = off).
MODEL_CATALOG_REFRESH_HOURS=6

ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# eleven_turbo_v2_5 is deprecated. Quality: eleven_multilingual_v2 · fast: eleven_flash_v2_5
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Eleven Music model (music_v1, the API default, is deprecated — removed 2027-01-31)
ELEVENLABS_MUSIC_MODEL_ID=music_v2_5

# --- Spend tracking ---
# Every paid call is recorded (Settings → Spend). OpenRouter reports real
# costs; ElevenLabs / Gemini use the COST_* rate card below. These are the
# defaults for the monthly budget, which Settings → Spend overrides.
# 0 = no cap. HARD_STOP=true refuses new paid generations (HTTP 402) at 100%.
SPEND_MONTHLY_BUDGET_USD=0
SPEND_HARD_STOP=true
# Rate card (USD) for providers that don't report cost, and for estimates.
COST_CHAT_PER_PLAN=0.01
COST_IMAGE_PER_ITEM=0.04
COST_VIDEO_PER_SECOND=0.15
COST_AVATAR_PER_SECOND=0.05
COST_TTS_PER_1K_CHARS=0.20
COST_MUSIC_PER_GENERATION=0.05
COST_SOUND_PER_GENERATION=0.10

# --- Job queue ---
# auto = RQ when Redis answers, inline otherwise (dev). required = 503 instead
# of running jobs inline (production). inline = never use Redis.
QUEUE_MODE=auto
QUEUE_JOB_TIMEOUT_SECONDS=14400

# --- Renders ---
# Keep the newest N completed renders per project (0 = keep all).
RENDER_RETENTION_KEEP=0

# --- Alerts (Slack / Discord incoming webhook; empty = log only) ---
ALERT_WEBHOOK_URL=

# --- Backups (scripts/backup.sh; see docs/backups.md) ---
# Directory to back up into: usually an Amazon S3 Files mount. Or s3://bucket/prefix (needs the aws CLI).
BACKUP_TARGET=
BACKUP_KEEP_DAYS=14
ALERT_DEDUPE_MINUTES=30
ALERT_PROVIDER_ERRORS=5

# --- YouTube publishing (Google OAuth client, type "Web application") ---
# Authorized redirect URI: {PUBLIC_BASE_URL}/api/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
